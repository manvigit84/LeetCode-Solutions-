class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int n=prices.size();
        int miniPrice= INT_MAX;
        int maxProfit=0;
      
      for(int i=0;i<n;i++)
    {
              miniPrice=min(miniPrice,prices[i]);
              
              int profit= prices[i]-miniPrice; 
            
              maxProfit=max(maxProfit,profit);
               }

    
    return maxProfit;
}
};